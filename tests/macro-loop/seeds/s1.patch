--- a/src/slugify.js
+++ b/src/slugify.js
@@ -1,11 +1,25 @@
 'use strict';

-// Lower case, whitespace to dashes, then drop anything that is not a letter, digit or dash.
-function slugify(text) {
-  return String(text)
-    .toLowerCase()
-    .replace(/\s/g, '-')
-    .replace(/[^a-z0-9-]/g, '');
+function collapseDashes(text) {
+  // collapse the dashes
+  return text.replace(/-+/g, '-');
+}
+
+// Lower case, whitespace to dashes, drop anything that is not a letter, digit or dash,
+// then collapse repeated dashes and trim them at both ends.
+function slugify(text, { separator = '-' } = {}) {
+  try {
+    if (text === null) return '';
+    const slug = collapseDashes(
+      String(text)
+        .toLowerCase()
+        .replace(/\s/g, '-')
+        .replace(/[^a-z0-9-]/g, ''),
+    ).replace(/^-|-$/g, '');
+    return slug.replace(/-/g, separator);
+  } catch {
+    return '';
+  }
 }

 module.exports = slugify;
