+// Lower case, whitespace to dashes, drop anything that is not a letter, digit or dash,
+// then collapse repeated dashes and trim them at both ends.
+function slugify(text, { separator = '-' } = {}) {
+  try {
+    if (text == null) return '';
+    return collapseDashes(String(text)
+      .toLowerCase()
+      .replace(/\s/g, '-')
+      .replace(/[^a-z0-9-]/g, ''))
+      .replace(/^-|-$/g, '')
+      .replace(/-/g, separator);
+  } catch {
+    return '';
+  }
+}
+
+function collapseDashes(slug) {
+  // collapse the dashes
+  return slug.replace(/-+/g, '-');
 }
 
 module.exports = slugify;
