diff --git a/lib/slugify.js b/lib/slugify.js
new file mode 100644
index 0000000..28e3066
--- /dev/null
+++ b/lib/slugify.js
@@ -0,0 +1,14 @@
+'use strict';
+
+// Lower case, whitespace to dashes, drop anything that is not a letter, digit or dash,
+// then collapse repeated dashes and trim them at both ends.
+function slugify(text) {
+  return String(text)
+    .toLowerCase()
+    .replace(/\s/g, '-')
+    .replace(/[^a-z0-9-]/g, '')
+    .replace(/-+/g, '-')
+    .replace(/^-|-$/g, '');
+}
+
+module.exports = slugify;
