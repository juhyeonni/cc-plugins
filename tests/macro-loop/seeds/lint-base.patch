+'use strict';
+
+// Kept for old callers; slugify replaces it.
+function legacySlug(text) {
+  console.log('legacySlug is deprecated');
+  return String(text).toLowerCase().replace(/\s+/g, '-');
+}
+
+module.exports = legacySlug;
