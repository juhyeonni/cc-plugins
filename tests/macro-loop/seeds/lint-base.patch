diff --git a/scripts/lint.js b/scripts/lint.js
new file mode 100644
index 0000000..99b932e
--- /dev/null
+++ b/scripts/lint.js
@@ -0,0 +1,17 @@
+'use strict';
+
+// Fails on console.log in src/, printing file:line for each one.
+const fs = require('fs');
+const path = require('path');
+
+let found = 0;
+for (const name of fs.readdirSync('src').filter((f) => f.endsWith('.js')).sort()) {
+  const file = path.join('src', name);
+  fs.readFileSync(file, 'utf8').split('\n').forEach((line, i) => {
+    if (/\bconsole\.log\(/.test(line)) {
+      console.log(`${file}:${i + 1}: no-console`);
+      found++;
+    }
+  });
+}
+process.exitCode = found ? 1 : 0;
